const $ = id => document.getElementById(id);
let idx = Number(localStorage.getItem("odruchy_idx") || 0);
let flipped = false;
let order = CARDS.map((_,i)=>i);
let filter = "all";

function sections(){
  return [...new Set(CARDS.map(c=>c.sec))];
}
function pool(){
  if(filter==="all") return CARDS.map((_,i)=>i);
  return CARDS.map((c,i)=>c.sec===filter?i:null).filter(i=>i!==null);
}
function save(){ localStorage.setItem("odruchy_idx", String(idx)); }

function render(){
  const list = pool();
  if(!list.length) return;
  if(idx >= list.length) idx = 0;
  if(idx < 0) idx = list.length-1;
  const c = CARDS[list[idx]];
  $("sec").textContent = c.sec;
  $("counter").textContent = (idx+1) + " / " + list.length;
  $("prog").style.width = ((idx+1)/list.length*100) + "%";
  $("front").innerHTML = `<div class="q">${esc(c.q)}</div>` +
    c.opts.map(o=>`<div class="opt">${esc(o)}</div>`).join("") +
    `<div class="hint">dotknij karty, żeby zobaczyć odpowiedź</div>`;
  $("back").innerHTML = `<div class="q-mini">${esc(c.q)}</div>
    <div class="ans-lbl">Odpowiedź</div>
    <div class="ans">${esc(c.ans || "brak klucza w oryginale")}</div>` +
    (c.note ? `<div class="note">${esc(c.note)}</div>` : "");
  $("card").classList.toggle("flip", flipped);
  $("prev").disabled = list.length<=1;
  $("next").disabled = list.length<=1;
  save();
}
function esc(s){
  return String(s).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
}
function flip(){ flipped = !flipped; $("card").classList.toggle("flip", flipped); }
function go(d){
  const list = pool();
  idx = (idx + d + list.length) % list.length;
  flipped = false;
  render();
}
$("flip").onclick = flip;
$("card").onclick = flip;
$("prev").onclick = () => go(-1);
$("next").onclick = () => go(1);
$("reset").onclick = () => { idx=0; flipped=false; render(); };
$("shuffle").onclick = () => {
  const list = pool();
  for(let i=list.length-1;i>0;i--){ const j=Math.floor(Math.random()*(i+1)); [list[i],list[j]]=[list[j],list[i]]; }
  // rebuild CARDS view by setting filter+custom? simpler: shuffle display via order of indices stored
  // implement by reordering a working array of indices in local state
  working = list;
  idx = 0; flipped=false;
  // monkey: change pool to use working if set
  window._work = list;
  render();
};
let working = null;
const _pool = pool;
pool = function(){ return window._work && filter==="all" ? window._work : _pool(); };

const sel = $("filter");
sel.innerHTML = `<option value="all">Wszystkie działy (103)</option>` +
  sections().map(s=>{
    const n = CARDS.filter(c=>c.sec===s).length;
    return `<option value="${esc(s)}">${esc(s)} (${n})</option>`;
  }).join("");
sel.onchange = () => { filter = sel.value; window._work=null; idx=0; flipped=false; render(); };

let x0=null;
document.getElementById("stage").addEventListener("touchstart", e=>{ x0=e.changedTouches[0].clientX; }, {passive:true});
document.getElementById("stage").addEventListener("touchend", e=>{
  if(x0==null) return;
  const dx = e.changedTouches[0].clientX - x0;
  x0=null;
  if(dx < -50) go(1);
  else if(dx > 50) go(-1);
}, {passive:true});

document.addEventListener("keydown", e=>{
  if(e.key==="ArrowRight" || e.key===" ") { e.preventDefault(); if(e.key===" ") flip(); else go(1); }
  if(e.key==="ArrowLeft") go(-1);
  if(e.key==="Enter") flip();
});

render();
</script>
